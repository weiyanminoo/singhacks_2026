# alternate.ai — copy to .env and fill in. NEVER commit .env.
# Seeds live in wallets.json (gitignored), written by scripts/setup_wallets.py.

# --- XRPL Testnet ---
XRPL_JSON_RPC=https://s.altnet.rippletest.net:51234/
XRPL_WSS=wss://s.altnet.rippletest.net:51233

# --- RLUSD ---
# Hex currency code for RLUSD (40-char, right-padded). Do not use the "RLUSD"
# symbol directly in Amount objects; XRPL needs the canonical hex.
RLUSD_CURRENCY=524C555344000000000000000000000000000000
# Issuer for the envelope asset. PENDING — see docs/phase-0-setup.md.
# The public testnet RLUSD faucet caps at 10 RLUSD/24h, which cannot fund a
# $400 envelope, so this may point at our own testnet issuer instead.
RLUSD_ISSUER=
RLUSD_TRUST_LIMIT=10000

# --- x402 (t54 facilitator) ---
# Values from https://xrpl-x402.t54.ai/docs/quickstart (Hosted Testnet row).
XRPL_FACILITATOR_URL=https://xrpl-facilitator-testnet.t54.ai
XRPL_NETWORK=xrpl:1

# --- Agent ---
OPENAI_API_KEY=
# Confirm the exact id against client.models.list() before relying on it.
OPENAI_MODEL=gpt-4o-mini

# --- Envelope ---
ENVELOPE_LIMIT=400
HOTEL_CAP=250
APPROVAL_THRESHOLD=150
AGENT_SOURCE_TAG=4021
